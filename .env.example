# Copy to .env. Live runs need Claude API credentials (console.anthropic.com).
# Either set ANTHROPIC_API_KEY here, or log in once with `ant auth login` and leave it commented out.
# ANTHROPIC_API_KEY=sk-ant-...
# Optional: another model for the agents (default claude-opus-5-5 from the config files)
# DEMO_MODEL=claude-sonnet-5-5
