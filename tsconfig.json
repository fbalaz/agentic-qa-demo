{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "app",
    "orchestrator",
    "gates",
    "viewer",
    "scripts",
    "tests",
    "playwright.config.ts"
  ],
  "exclude": [
    "tests/generated",
    "node_modules",
    "runs"
  ]
}